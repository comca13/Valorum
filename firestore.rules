rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isValidId(userId) && isOwner(userId);
      allow create, update: if isValidId(userId) && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;
      allow delete: if isValidId(userId) && isOwner(userId);

      // User data subcollection (planner, alerts, configurations)
      match /data/{docId} {
        allow read: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isValidId(docId) && isOwner(userId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      }
    }
  }
}
